---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Stryde Marketing helps local businesses dominate search, build stunning websites, and grow with smart digital marketing." } = Astro.props;
const GA4_ID = "G-RSN3FTFXEL";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,600;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- GA4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
    <script is:inline define:vars={{ GA4_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA4_ID, {
        page_path: window.location.pathname,
      });
    </script>

    <!-- Global Styles -->
    <style is:global>
      /* ─── Reset & Base ─── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 16px;
        color: #111;
        background: #fff;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* ─── Design Tokens ─── */
      :root {
        --blue: #2A63FF;
        --blue-dark: #1a4fd6;
        --lime: #B7FF5A;
        --black: #000000;
        --white: #FFFFFF;
        --grey-light: #F5F7FA;
        --grey-mid: #9CA3AF;
        --grey-text: #4B5563;
        --radius: 12px;
        --radius-lg: 20px;
      }

      /* ─── Typography ─── */
      h1, h2, h3 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-style: italic;
        line-height: 1.1;
        letter-spacing: -0.02em;
      }
      h4, .label {
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-style: normal;
      }

      /* ─── Layout ─── */
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px;
      }
      section { padding: 96px 0; }

      /* ─── NAV ─── */
      nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0,0,0,0.06);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 68px;
      }
      .nav-logo img { height: 44px; width: auto; }
      .nav-links {
        display: flex;
        gap: 32px;
        list-style: none;
      }
      .nav-links a {
        text-decoration: none;
        color: #111;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 0.03em;
        transition: color 0.2s;
      }
      .nav-links a:hover { color: var(--blue); }
      .nav-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--blue);
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 22px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.2s, box-shadow 0.2s;
      }
      .nav-cta:hover { background: var(--blue-dark); box-shadow: 0 4px 16px rgba(42,99,255,0.3); }

      /* ─── HERO ─── */
      .hero {
        background: #000;
        color: #fff;
        padding: 0;
        overflow: hidden;
        position: relative;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 88vh;
        align-items: center;
      }
      .hero-content {
        padding: 80px 0 80px 0;
        position: relative;
        z-index: 2;
      }
      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(183,255,90,0.12);
        border: 1px solid rgba(183,255,90,0.3);
        color: var(--lime);
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 6px 14px;
        border-radius: 100px;
        margin-bottom: 28px;
      }
      .hero-badge span { width: 6px; height: 6px; background: var(--lime); border-radius: 50%; animation: pulse 2s infinite; }
      @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
      .hero h1 {
        font-size: clamp(40px, 5vw, 64px);
        color: #fff;
        margin-bottom: 24px;
      }
      .hero h1 em {
        font-style: italic;
        color: var(--lime);
      }
      .hero-sub {
        font-size: 18px;
        color: #9CA3AF;
        max-width: 460px;
        margin-bottom: 40px;
        line-height: 1.65;
      }
      .hero-actions {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        align-items: center;
      }
      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--blue);
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 15px;
        padding: 14px 28px;
        border-radius: 10px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
      }
      .btn-primary:hover { background: var(--blue-dark); transform: translateY(-1px); box-shadow: 0 8px 24px rgba(42,99,255,0.4); }
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 15px;
        padding: 14px 28px;
        border-radius: 10px;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.2);
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
      }
      .btn-secondary:hover { border-color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.05); }
      .hero-trust {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 48px;
        padding-top: 40px;
        border-top: 1px solid rgba(255,255,255,0.08);
      }
      .trust-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 100px;
        padding: 8px 16px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 13px;
        color: #D1D5DB;
      }
      .trust-pill .dot { width: 6px; height: 6px; background: var(--lime); border-radius: 50%; flex-shrink: 0; }

      .hero-visual {
        position: relative;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 60px 0;
      }
      .hero-card-stack {
        position: relative;
        width: 100%;
        max-width: 440px;
      }
      .metric-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 20px 24px;
        backdrop-filter: blur(8px);
      }
      .metric-card + .metric-card { margin-top: 16px; }
      .metric-card .mc-label {
        font-size: 11px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--grey-mid);
        margin-bottom: 10px;
      }
      .metric-card .mc-value {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-style: italic;
        font-size: 36px;
        color: #fff;
      }
      .metric-card .mc-value span { color: var(--lime); }
      .metric-card .mc-sub { font-size: 13px; color: #6B7280; margin-top: 4px; }
      .metric-bar { height: 6px; background: rgba(255,255,255,0.06); border-radius: 4px; margin-top: 14px; overflow: hidden; }
      .metric-bar-fill { height: 100%; background: linear-gradient(90deg, var(--blue), var(--lime)); border-radius: 4px; }
      .audit-preview-list { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-top: 12px; }
      .audit-preview-list li { display: flex; align-items: center; gap: 10px; font-size: 13px; color: #D1D5DB; }
      .apl-check {
        width: 20px; height: 20px;
        background: rgba(183,255,90,0.12);
        border: 1px solid rgba(183,255,90,0.3);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 10px; color: var(--lime);
        flex-shrink: 0;
      }
      .industry-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
      .industry-tags span {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 100px;
        padding: 5px 12px;
        font-size: 12px;
        color: #9CA3AF;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
      }
      /* BG glow */
      .hero::before {
        content: '';
        position: absolute;
        top: -200px; right: -200px;
        width: 700px; height: 700px;
        background: radial-gradient(circle, rgba(42,99,255,0.15) 0%, transparent 70%);
        pointer-events: none;
      }

      /* ─── PROBLEM SECTION ─── */
      .problem { background: var(--grey-light); }
      .problem .section-label {
        display: inline-block;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--blue);
        margin-bottom: 16px;
      }
      .problem h2 {
        font-size: clamp(32px, 4vw, 48px);
        color: #000;
        max-width: 640px;
        margin-bottom: 20px;
      }
      .problem-lead {
        font-size: 18px;
        color: var(--grey-text);
        max-width: 560px;
        margin-bottom: 56px;
      }
      .pain-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }
      .pain-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: var(--radius);
        padding: 28px;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .pain-card:hover { border-color: var(--blue); box-shadow: 0 4px 20px rgba(42,99,255,0.08); }
      .pain-icon {
        width: 44px; height: 44px;
        background: rgba(42,99,255,0.08);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 16px;
        font-size: 20px;
      }
      .pain-card h4 { font-size: 16px; margin-bottom: 8px; color: #000; }
      .pain-card p { font-size: 14px; color: var(--grey-text); line-height: 1.6; }

      /* ─── SERVICES ─── */
      .services { background: #fff; }
      .section-header { text-align: center; margin-bottom: 64px; }
      .section-header .section-label {
        display: inline-block;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--blue);
        margin-bottom: 12px;
      }
      .section-header h2 {
        font-size: clamp(30px, 3.5vw, 44px);
        color: #000;
        margin-bottom: 16px;
      }
      .section-header p {
        font-size: 17px;
        color: var(--grey-text);
        max-width: 520px;
        margin: 0 auto;
      }
      .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }
      .service-card {
        border: 1px solid #E5E7EB;
        border-radius: var(--radius-lg);
        padding: 36px 28px;
        position: relative;
        overflow: hidden;
        transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
      }
      .service-card:hover { border-color: var(--blue); transform: translateY(-4px); box-shadow: 0 12px 36px rgba(42,99,255,0.1); }
      .service-card.featured {
        background: #000;
        border-color: #000;
        color: #fff;
      }
      .service-card.featured h3, .service-card.featured p { color: #fff; }
      .service-card.featured .svc-tag { background: rgba(183,255,90,0.15); color: var(--lime); border-color: rgba(183,255,90,0.3); }
      .service-icon {
        width: 52px; height: 52px;
        border-radius: 14px;
        background: rgba(42,99,255,0.08);
        display: flex; align-items: center; justify-content: center;
        font-size: 24px;
        margin-bottom: 24px;
      }
      .service-card.featured .service-icon { background: rgba(42,99,255,0.2); }
      .svc-tag {
        display: inline-block;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: rgba(42,99,255,0.08);
        color: var(--blue);
        border: 1px solid rgba(42,99,255,0.15);
        padding: 4px 10px;
        border-radius: 6px;
        margin-bottom: 16px;
      }
      .service-card h3 {
        font-size: 22px;
        color: #000;
        margin-bottom: 12px;
        font-style: italic;
      }
      .service-card p { font-size: 14px; color: var(--grey-text); line-height: 1.65; margin-bottom: 24px; }
      .service-features { list-style: none; display: flex; flex-direction: column; gap: 8px; }
      .service-features li {
        display: flex; align-items: center; gap: 10px;
        font-size: 13px; color: var(--grey-text);
      }
      .service-card.featured .service-features li { color: #9CA3AF; }
      .service-features li::before {
        content: '';
        width: 6px; height: 6px;
        background: var(--blue);
        border-radius: 50%;
        flex-shrink: 0;
      }
      .service-card.featured .service-features li::before { background: var(--lime); }
      .services-grid-bottom {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
        max-width: 760px;
        margin: 24px auto 0;
      }

      /* ─── WHY STRYDE ─── */
      .results { background: #000; color: #fff; }
      .results .section-header .section-label { color: var(--lime); }
      .results .section-header h2 { color: #fff; }
      .results .section-header p { color: #9CA3AF; }
      .diff-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 64px;
      }
      .diff-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: var(--radius-lg);
        padding: 32px;
        transition: border-color 0.2s;
      }
      .diff-card:hover { border-color: rgba(42,99,255,0.4); }
      .diff-icon {
        width: 44px; height: 44px;
        background: rgba(42,99,255,0.12);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
        margin-bottom: 18px;
      }
      .diff-card h4 { font-size: 17px; color: #fff; margin-bottom: 10px; }
      .diff-card p { font-size: 14px; color: #6B7280; line-height: 1.65; }
      .process-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        position: relative;
      }
      .process-row::before {
        content: '';
        position: absolute;
        top: 28px; left: 12%; right: 12%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(42,99,255,0.4), var(--lime), rgba(42,99,255,0.4), transparent);
      }
      .process-step { text-align: center; padding: 0 20px; position: relative; }
      .step-num {
        width: 56px; height: 56px;
        background: rgba(42,99,255,0.15);
        border: 1px solid rgba(42,99,255,0.3);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 20px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-style: italic;
        font-size: 18px;
        color: var(--blue);
        position: relative;
        z-index: 1;
      }
      .process-step h4 { font-size: 15px; color: #fff; margin-bottom: 8px; }
      .process-step p { font-size: 13px; color: #6B7280; line-height: 1.5; }

      /* ─── AUDIT FORM ─── */
      .audit {
        background: linear-gradient(135deg, #0a0a0a 0%, #0d1929 100%);
        color: #fff;
        position: relative;
        overflow: hidden;
      }
      .audit::before {
        content: '';
        position: absolute;
        bottom: -300px; left: 50%;
        transform: translateX(-50%);
        width: 800px; height: 800px;
        background: radial-gradient(circle, rgba(42,99,255,0.12) 0%, transparent 65%);
        pointer-events: none;
      }
      .audit-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: start;
      }
      .audit-copy .section-label {
        display: inline-block;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--lime);
        margin-bottom: 16px;
      }
      .audit-copy h2 {
        font-size: clamp(30px, 3.5vw, 44px);
        color: #fff;
        margin-bottom: 20px;
      }
      .audit-copy h2 em { font-style: italic; color: var(--lime); }
      .audit-copy p { font-size: 17px; color: #9CA3AF; line-height: 1.65; margin-bottom: 32px; }
      .audit-includes { list-style: none; display: flex; flex-direction: column; gap: 14px; }
      .audit-includes li {
        display: flex; align-items: flex-start; gap: 12px;
        font-size: 15px; color: #D1D5DB;
      }
      .audit-includes li .check {
        width: 22px; height: 22px;
        background: rgba(183,255,90,0.12);
        border: 1px solid rgba(183,255,90,0.3);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
        color: var(--lime);
        margin-top: 1px;
      }

      .audit-form-wrap {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: var(--radius-lg);
        padding: 40px;
      }
      .form-heading {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-style: italic;
        font-size: 22px;
        color: #fff;
        margin-bottom: 6px;
      }
      .form-sub { font-size: 14px; color: #6B7280; margin-bottom: 32px; }
      .form-group { margin-bottom: 20px; }
      .form-group label {
        display: block;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 13px;
        color: #D1D5DB;
        margin-bottom: 8px;
        letter-spacing: 0.02em;
      }
      .form-group input,
      .form-group select {
        width: 100%;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        padding: 13px 16px;
        font-family: 'Inter', sans-serif;
        font-size: 15px;
        color: #fff;
        outline: none;
        transition: border-color 0.2s, background 0.2s;
        appearance: none;
      }
      .form-group input::placeholder { color: #4B5563; }
      .form-group input:focus,
      .form-group select:focus { border-color: var(--blue); background: rgba(42,99,255,0.06); }
      .form-group select { cursor: pointer; }
      .form-group select option { background: #1a1a2e; color: #fff; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .form-submit {
        width: 100%;
        background: var(--blue);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 16px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        margin-top: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
      }
      .form-submit:hover { background: var(--blue-dark); transform: translateY(-1px); box-shadow: 0 8px 24px rgba(42,99,255,0.4); }
      .form-submit svg { transition: transform 0.2s; }
      .form-submit:hover svg { transform: translateX(3px); }
      .form-disclaimer { font-size: 12px; color: #4B5563; text-align: center; margin-top: 12px; }

      /* ─── FOOTER ─── */
      footer {
        background: #000;
        border-top: 1px solid rgba(255,255,255,0.06);
        padding: 48px 0 32px;
      }
      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 24px;
      }
      .footer-logo img { height: 36px; }
      .footer-links {
        display: flex;
        gap: 28px;
        list-style: none;
      }
      .footer-links a { font-size: 13px; color: #6B7280; text-decoration: none; transition: color 0.2s; }
      .footer-links a:hover { color: #fff; }
      .footer-copy { font-size: 12px; color: #4B5563; width: 100%; text-align: center; margin-top: 32px; }

      /* ─── Responsive ─── */
      @media (max-width: 900px) {
        .hero-grid { grid-template-columns: 1fr; min-height: auto; }
        .hero-visual { display: none; }
        .hero-content { padding: 72px 0; }
        .pain-grid { grid-template-columns: 1fr 1fr; }
        .services-grid { grid-template-columns: 1fr 1fr; }
